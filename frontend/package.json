{
  "name": "@arcade-actions/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 26000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 26000 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write . ../README.md ../CLAUDE.md ../AGENTS.md ../platform.yml ../.github/workflows/ci.yml",
    "format:check": "prettier --check . ../README.md ../CLAUDE.md ../AGENTS.md ../platform.yml ../.github/workflows/ci.yml"
  },
  "devDependencies": {
    "@ahara/standards": "github:chris-arsenault/ahara-standards#30e038a09b01c8f72e509e3fb1e7aa76003cda3a",
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
